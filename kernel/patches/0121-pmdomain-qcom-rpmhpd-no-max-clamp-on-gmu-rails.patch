From: ROCKNIX <noreply@rocknix.org>
Subject: [PATCH] pmdomain: qcom: rpmhpd: don't clamp GMU-managed rails pre-sync_state

Give the GMU-managed rails on the SoCs we ship dedicated power-domain
descriptors that are treated as synced from boot, so their pre-sync votes
use the real lowest corner instead of being clamped to max. These rails
carry no bootloader state and have no other consumers, so the clamp
protects nothing on them.

Covers gfx on SM8550 and gfx/gmxc on SM8750. SM8650 is left on the shared
descriptor: no clamp problem has been observed there. The shared gfx/gmxc
descriptors stay unchanged for the other Qualcomm SoCs.

---
diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -122,6 +122,12 @@
 	.res_name = "gfx.lvl",
 };
 
+static struct rpmhpd gfx_gmu = {
+	.pd = { .name = "gfx", },
+	.res_name = "gfx.lvl",
+	.state_synced = true,
+};
+
 static struct rpmhpd gfx1 = {
 	.pd = { .name = "gfx1", },
 	.res_name = "gfx1.lvl",
@@ -227,6 +233,12 @@
 	.res_name = "gmxc.lvl",
 };

+static struct rpmhpd gmxc_sm8750 = {
+	.pd = { .name = "gmxc", },
+	.res_name = "gmxc.lvl",
+	.state_synced = true,
+};
+
 /* Eliza RPMH powerdomains */
 static struct rpmhpd *eliza_rpmhpds[] = {
 	[RPMHPD_CX] = &cx,
@@ -559,7 +571,7 @@
 	[RPMHPD_CX] = &cx,
 	[RPMHPD_CX_AO] = &cx_ao,
 	[RPMHPD_EBI] = &ebi,
-	[RPMHPD_GFX] = &gfx,
+	[RPMHPD_GFX] = &gfx_gmu,
 	[RPMHPD_LCX] = &lcx,
 	[RPMHPD_LMX] = &lmx,
 	[RPMHPD_MMCX] = &mmcx_w_cx_parent,
@@ -606,8 +618,8 @@
 	[RPMHPD_CX] = &cx,
 	[RPMHPD_CX_AO] = &cx_ao,
 	[RPMHPD_EBI] = &ebi,
-	[RPMHPD_GFX] = &gfx,
-	[RPMHPD_GMXC] = &gmxc,
+	[RPMHPD_GFX] = &gfx_gmu,
+	[RPMHPD_GMXC] = &gmxc_sm8750,
 	[RPMHPD_LCX] = &lcx,
 	[RPMHPD_LMX] = &lmx,
 	[RPMHPD_MX] = &mx,
