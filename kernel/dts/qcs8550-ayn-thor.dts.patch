From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: thor: fix hall wake and touch orientation

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/input/gpio-keys.h>
 #include "qcs8550-ayn-common.dtsi"
 
 / {
@@ -30,13 +31,16 @@
 
 	gpio-keys-lid {
 		compatible = "gpio-keys";
+		pinctrl-0 = <&hall_lid_n>;
+		pinctrl-names = "default";
 
 		hall-lid-sensor {
 			label = "Hall Lid Sensor";
 			gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
 			linux,input-type = <EV_SW>;
 			linux,code = <SW_LID>;
 			linux,can-disable;
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
 			wakeup-source;
 		};
 	};
@@ -275,8 +279,6 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1920>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "top_touchscreen";
 	};
@@ -393,8 +395,6 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1240>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "bottom_touchscreen";
 
@@ -452,6 +450,15 @@
 		bias-pull-up;
 		output-disable;
 	};
+
+	/* Open-drain hall output: with no pull-up the released (lid open)
+	   level is undefined. */
+	hall_lid_n: hall-lid-n-state {
+		pins = "gpio17";
+		function = "gpio";
+		bias-pull-up;
+		output-disable;
+	};
 };
 
 &remoteproc_adsp {
