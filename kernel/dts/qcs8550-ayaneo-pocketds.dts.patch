From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: pocketds: drive the lower panel with ST7703

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketds.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketds.dts
@@ -39,6 +39,21 @@
 		enable-active-high;
 	};

+	/*
+	 * The lower panel's ST7703 IOVCC rail is switched by an expander
+	 * GPIO; the panel driver models it as a plain iovcc supply, so wrap
+	 * the enable line in a fixed regulator. The level is the ST7703
+	 * IOVCC nominal and wants confirming against the board.
+	 */
+	vreg_panel1_iovcc: regulator-panel1-iovcc {
+		compatible = "regulator-fixed";
+		regulator-name = "panel1-iovcc";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tca6408 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 };

 &tlmm {
@@ -219,13 +234,13 @@
 	status = "okay";

 	panel@0 {
-		compatible = "ayaneo,pocket-ds-secondary-panel";
+		compatible = "ayaneo,pocket-ds-lower-panel";
 		reg = <0>;
 		pinctrl-0 = <&sde_dsi1_active>;
 		pinctrl-1 = <&sde_dsi1_suspend>;
 		pinctrl-names = "default", "sleep";
-		avdd-supply = <&sgm3804>;
-		enable-gpio = <&tca6408 0 GPIO_ACTIVE_HIGH>;
+		vcc-supply = <&sgm3804>;
+		iovcc-supply = <&vreg_panel1_iovcc>;
 		reset-gpios = <&tca6408 2 GPIO_ACTIVE_LOW>;
 		rotation = <270>;
 		backlight = <&backlight>;
