From 85b4537ac62798276ba687e30d29ad0250889ee4 Mon Sep 17 00:00:00 2001
From: Radical <radical@radical.fun>
Date: Wed, 5 Aug 2026 18:12:31 +0200
Subject: [PATCH] steam change

---
 usr/share/gamescope-session-plus/sessions.d/steam | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/usr/share/gamescope-session-plus/sessions.d/steam b/usr/share/gamescope-session-plus/sessions.d/steam
index 3ebe7b4..06d4a25 100644
--- a/usr/share/gamescope-session-plus/sessions.d/steam
+++ b/usr/share/gamescope-session-plus/sessions.d/steam
@@ -108,7 +108,13 @@ if command -v kwriteconfig6 >/dev/null; then
   kwriteconfig6 --file gtk-3.0/settings.ini  --group Settings --key gtk-cursor-theme-name steam
 fi
 
-export CLIENTCMD="steam -gamepadui -steamos3 -steampal -steamdeck"
+export STEAM_EXTRA_COMPAT_TOOLS_PATHS="/usr/share/steam/compatibilitytools.d:${HOME}/.local/share/Steam/compatibilitytools.d"
+
+# The fallback appid has gamescope show the wrapper's splash window whenever
+# Steam has no window of its own; the splash units check the same kill-switch.
+export GAMESCOPE_FALLBACK_APPID=0x41524d41
+export CLIENTCMD='/usr/libexec/armada/launch-steam -gamepadui -steamos3 -steampal -steamdeck -noverifyfiles -noshaders'
+[[ -e /etc/armada/splash-disabled ]] || export CLIENTCMD="/usr/libexec/armada/armada-splash-run ${CLIENTCMD}"
 
 # Workaround for Steam login issue while Steam client change propagates out of Beta
 touch "${HOME}"/.steam/root/config/SteamAppData.vdf || true
-- 
2.55.0
